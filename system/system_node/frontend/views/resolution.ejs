<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Image Resolution Result</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <h1>🩻 Enhanced X-Ray Result</h1>

    <% if (result.error) { %>
      result.message
      <p class="error"><%= result.error %></p>
    <% } else { %>
      <div class="result">
        <h2><%= result.message %></h2>
        <img src="/<%= result.output_path %>" alt="Enhanced Image" style="max-width:400px; border-radius:10px;">
        <p><strong>Metrics:</strong> <%= result.metrics %></p>

        <!-- Download Button -->
        <a href="/<%= result.output_path %>" download class="btn">
          ⬇️ Download Enhanced Image
        </a>
      </div>
    <% } %>

    <a href="/resolve" class="btn">🔙 Upload Another</a>
  </div>
</body>
</html>
