<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard</title>

  <!-- Tailwind CDN (optional but recommended) -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 flex h-screen">

  <!-- Sidebar -->
  <aside class="w-64 bg-white shadow-md flex flex-col p-6">
    <h2 class="text-2xl font-bold mb-8">Menu</h2>

    <nav class="flex flex-col space-y-4">
      <a href="/profile" class="text-gray-700 hover:text-blue-600">Profile</a>
      <a href="/history" class="text-gray-700 hover:text-blue-600">History</a>
    <a href="/feedback" class="text-gray-700 hover:text-blue-600">Feedback</a>

      <a href="/settings" class="text-gray-700 hover:text-blue-600">Settings</a>
      <a href="/logout" class="text-gray-700 hover:text-red-600">Logout</a>
    </nav>
  </aside>

  <!-- Main Content -->
  <main class="flex-1 p-10">
    <div class="mb-10">
      <h1 class="text-4xl font-bold">Hi Vera 👋</h1>
      <p class="text-gray-600 mt-2">What would you like to do today?</p>
    </div>

    <!-- Action Buttons -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <!-- Resolve Image -->
      <a href="/resolve" 
         class="bg-blue-600 text-white p-8 rounded-xl shadow hover:bg-blue-700 transition text-center">
        <h2 class="text-2xl font-semibold mb-2">Resolve an Image</h2>
        <p>Upload an image for analysis</p>
      </a>

      <!-- Run Prediction -->
      <a href="/predict" 
         class="bg-green-600 text-white p-8 rounded-xl shadow hover:bg-green-700 transition text-center">
        <h2 class="text-2xl font-semibold mb-2">Run a Prediction</h2>
        <p>Send data to your model</p>
      </a>

    </div>
  </main>

</body>
</html>
